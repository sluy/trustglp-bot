# =============================================================
# Telecambios VE — White-Label Base | Archivo de Configuración
# =============================================================
# 1. Copia este archivo: cp .env.example .env
# 2. Rellena cada variable con los valores de tu cliente
# 3. Nunca subas el .env real a Git
# =============================================================

# ─── IDENTIDAD DEL CLIENTE ────────────────────────────────────
CLIENT_NAME="Telecambios VE"
CLIENT_SLUG="telecambios-ve"

# ─── INFRAESTRUCTURA ──────────────────────────────────────────
POSTGRES_USER=p2p_admin
POSTGRES_PASSWORD=CHANGE_ME_STRONG_PASSWORD
POSTGRES_DB=p2p_core
DATABASE_URL=postgresql://p2p_admin:CHANGE_ME_STRONG_PASSWORD@postgres:5432/p2p_core
REDIS_URL=redis://redis:6379

# ─── SEGURIDAD ────────────────────────────────────────────────
# JWT secret para tokens de autenticación (mínimo 32 caracteres)
JWT_SECRET=CHANGE_ME_SUPER_SECRET_MINIMUM_32_CHARS
# Clave de cifrado para API keys guardadas en panel admin (exactamente 32 chars)
ENCRYPTION_KEY=CHANGE_ME_32_CHARS_ENCRYPTION_KEY
# Contraseña de acceso básico al panel /admin
ADMIN_PASSWORD=CHANGE_ME_ADMIN_PASSWORD

# ─── ADMIN DASHBOARD (Next.js) ────────────────────────────────
NEXT_PUBLIC_CLIENT_NAME="Telecambios VE"
NEXT_PUBLIC_CLIENT_SLUG="telecambios-ve"
NEXT_PUBLIC_SUPPORT_EMAIL="soporte@telecambiosve.com"
# Opciones: telecambios-ve | frank | rafa
NEXT_PUBLIC_THEME=telecambios-ve
# Opciones: (vacío = full) | p2p_only
NEXT_PUBLIC_CLIENT_MODE=
# URL del backend order-manager
NEXT_PUBLIC_API_URL=http://localhost:3000

# ─── ORDER MANAGER (NestJS) ───────────────────────────────────
PORT=3000
# Las API keys de Binance/Bybit se configuran desde el Panel Admin
# y se almacenan cifradas. También se pueden precargar aquí:
BINANCE_API_KEY=
BINANCE_API_SECRET=
BYBIT_API_KEY=
BYBIT_API_SECRET=
BYBIT_TESTNET=false

# ─── BYBIT GRID BOT (Python) ──────────────────────────────────
TELEGRAM_BOT_TOKEN=8204244360:AAEhBziF0jBMBcI91eVhreQd7uQ_IRi60-8
TELEGRAM_CHAT_ID=-1004472055488
TELEGRAM_REPORTS_CHAT_ID=-1004302088476
# Capital base del grid bot (en USDT)
GRID_CAPITAL=10000
GRID_LEVERAGE=3

# ─── MARKET SCANNER (Python/FastAPI) ──────────────────────────
SCANNER_PORT=8000
SCAN_INTERVAL_SECONDS=30

# ─── AUTO-PAY BOT (Módulo Adicional) ─────────────────────────
# Solo activo si se usa el perfil Docker: --profile optional
BANESCO_USER=
BANESCO_PASSWORD=
