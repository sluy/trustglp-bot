# ===========================================
# Telecambios VE — Dashboard Config
# ===========================================
# Copia como .env.local y rellena los valores

# ─── IDENTIDAD ────────────────────────────
NEXT_PUBLIC_CLIENT_NAME="Telecambios VE"
NEXT_PUBLIC_CLIENT_SLUG="telecambios-ve"
NEXT_PUBLIC_SUPPORT_EMAIL="soporte@telecambiosve.com"

# ─── TEMA VISUAL ──────────────────────────
# Opciones: telecambios-ve | frank | rafa
NEXT_PUBLIC_THEME=telecambios-ve

# ─── MÓDULOS ──────────────────────────────
# Vacío = modo completo | p2p_only = solo P2P
NEXT_PUBLIC_CLIENT_MODE=

# ─── API URLS ─────────────────────────────
NEXT_PUBLIC_API_URL=http://localhost:3000

# ─── SEGURIDAD ────────────────────────────
ADMIN_PASSWORD=admin147258
