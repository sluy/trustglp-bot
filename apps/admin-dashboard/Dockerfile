FROM node:18-alpine
WORKDIR /app

COPY package*.json ./
RUN npm install

# Recibir variables de Easypanel como build-args
ARG NEXT_PUBLIC_API_URL
ARG NEXT_PUBLIC_P2P_API_URL
ARG NEXT_PUBLIC_CLIENT_MODE
ARG NEXT_PUBLIC_THEME
ARG ADMIN_PASSWORD
ARG NEXT_PUBLIC_DEMO_MODE
ARG NEXT_PUBLIC_CLIENT_NAME
ARG NEXT_PUBLIC_CLIENT_SLUG

# Exponerlas como ENV para que next build las vea
ENV NEXT_PUBLIC_API_URL=$NEXT_PUBLIC_API_URL
ENV NEXT_PUBLIC_P2P_API_URL=$NEXT_PUBLIC_P2P_API_URL
ENV NEXT_PUBLIC_CLIENT_MODE=$NEXT_PUBLIC_CLIENT_MODE
ENV NEXT_PUBLIC_THEME=$NEXT_PUBLIC_THEME
ENV NEXT_PUBLIC_DEMO_MODE=$NEXT_PUBLIC_DEMO_MODE
ENV NEXT_PUBLIC_CLIENT_NAME=$NEXT_PUBLIC_CLIENT_NAME
ENV NEXT_PUBLIC_CLIENT_SLUG=$NEXT_PUBLIC_CLIENT_SLUG

# === DIAGNÓSTICO: confirmar que las variables llegan ===
RUN echo "=== BUILD CONFIG ===" && \
    echo "NEXT_PUBLIC_THEME=$NEXT_PUBLIC_THEME" && \
    echo "NEXT_PUBLIC_DEMO_MODE=$NEXT_PUBLIC_DEMO_MODE" && \
    echo "NEXT_PUBLIC_CLIENT_NAME=$NEXT_PUBLIC_CLIENT_NAME"

COPY . .
RUN npm run build

EXPOSE 3000
CMD ["npm", "start"]
